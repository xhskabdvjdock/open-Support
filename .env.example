# Copy to .env.local and fill in values. Never commit .env.local.
# Server-only: GROQ_API_KEY must never be exposed to the browser (no NEXT_PUBLIC_ prefix).

GROQ_API_KEY=gsk_your_key_here

# Model configuration (server-side, changeable without touching client code).
# Vision model must support image inputs. Verified defaults (Groq docs, 2026):
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TEXT_MODEL=openai/gpt-oss-120b
